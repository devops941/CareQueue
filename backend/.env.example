# ==============================================================================
# CareQueue Backend Environment Configuration Example
# ==============================================================================

# Database Connection (MongoDB Atlas Cloud Cluster or local: mongodb://localhost:27017)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.uurxkmz.mongodb.net/carequeue

# MongoDB Database Name
DB_NAME=carequeue

# JWT Secret Key for Session Authentication (Use a secure 32+ character random string)
SECRET_KEY=carequeue-dev-secret-key-change-in-production-32chars

# Access Token Validity (480 minutes = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Environment Mode (development / production)
ENVIRONMENT=development

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000

# Allowed Frontend Origins (Comma-separated for CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
